# Normalize line endings for anything Git considers text.
* text=auto eol=lf

# Godot source/resource text formats — force LF explicitly.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.cfg text eol=lf
*.csv text eol=lf

# Binary assets — never diff, never EOL-normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
