; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Detective Mosa"
run/main_scene="res://src/scenes/Title.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0784314, 0.0627451, 0.054902, 1)
boot_splash/show_image=false
config/icon="res://art/ui/icon/icon-legacy-192.png"
; Godot's own default (true) quits the app immediately on Android's hardware BACK,
; before NOTIFICATION_WM_GO_BACK_REQUEST ever reaches the SceneTree - found on the real
; device (DM-051's device pass): BACK from Title closed the app outright instead of
; opening the quit-confirm dialog, with the whole SceneRouter._notification() handler
; never running at all. false routes BACK through that notification instead, letting
; SceneRouter._handle_back() actually receive it (DM-051, tickets/M1-design-system/).
; Verified against ProjectSettings.get_setting() directly before relying on the key name.
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://data/audio_buses.tres"

[autoload]

GameState="*res://src/autoload/GameState.gd"
SaveManager="*res://src/autoload/SaveManager.gd"
AudioDirector="*res://src/autoload/AudioDirector.tscn"
SceneRouter="*res://src/autoload/SceneRouter.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://data/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.fil.translation")
locale/fallback="fil"

[rendering]

textures/vram_compression/import_etc2_astc=true
