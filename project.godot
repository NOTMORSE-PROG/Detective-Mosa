; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Detective Mosa"
run/main_scene="res://src/scenes/Title.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0784314, 0.0627451, 0.054902, 1)
boot_splash/show_image=false
config/icon="res://art/ui/icon/icon-legacy-192.png"

[audio]

buses/default_bus_layout="res://data/audio_buses.tres"

[autoload]

GameState="*res://src/autoload/GameState.gd"
SaveManager="*res://src/autoload/SaveManager.gd"
AudioDirector="*res://src/autoload/AudioDirector.tscn"
SceneRouter="*res://src/autoload/SceneRouter.gd"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"alingmila": "res://data/dialogic/characters/alingmila.dch",
"alingvilma": "res://data/dialogic/characters/alingvilma.dch",
"bugoy": "res://data/dialogic/characters/bugoy.dch",
"jorge": "res://data/dialogic/characters/jorge.dch",
"mangtomas": "res://data/dialogic/characters/mangtomas.dch",
"mangver": "res://data/dialogic/characters/mangver.dch",
"mosa": "res://data/dialogic/characters/mosa.dch"
}
directories/dtl_directory={
"dm012_smoke": "res://data/dialogic/timelines/dm012_smoke.dtl",
"dm013_choice_smoke": "res://data/dialogic/timelines/dm013_choice_smoke.dtl",
"dm013_longstring_smoke": "res://data/dialogic/timelines/dm013_longstring_smoke.dtl",
"prologue": "res://data/dialogic/timelines/prologue.dtl"
}
layout/style_directory={
"": "res://data/dialogic/styles/detective_mosa_style.tres"
}
layout/default_style="res://data/dialogic/styles/detective_mosa_style.tres"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom="res://data/theme.tres"

[input]

dialogic_default_action={
